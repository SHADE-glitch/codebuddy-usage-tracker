[Unit]
Description=CodeBuddy usage tracker sync
Documentation=https://github.com/SHADE-glitch/codebuddy-usage-tracker/blob/master/README.zh-CN.md

[Service]
Type=oneshot
# %h-relative on purpose: systemd's user PATH does not include ~/.local/bin, and
# an absolute path would hardcode one machine's home directory.
ExecStart=%h/.local/bin/cbut sync --quiet
Environment=LANG=C.UTF-8
Environment=PYTHONIOENCODING=utf-8
Nice=10
